package com.learn.singleresponsibility;

public class ShoppingCart {
	
	
	public double calculatePrice(double actualPrice,String type) {
		
		if(type.equals("prime")) {
			//prime customer 20% discount
			return actualPrice-actualPrice*0.20;
			
		}
		else {
			return actualPrice;
		}
		
		
		
	}

}
